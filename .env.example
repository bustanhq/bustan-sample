# Copy this file to .env and give each value. The environment overrides the file.
# Make the secret with: uv run python -c 'import secrets; print(secrets.token_urlsafe(48))'
IDENTITY_JWT_SECRET=replace-with-a-random-value-of-at-least-32-characters
IDENTITY_JWT_ISSUER=bustan-sample
IDENTITY_TOKEN_TTL_MINUTES=15
# The number of job workers, and the delay before the first retry of a failed
# job. Each next retry waits two times longer.
JOBS_WORKERS=2
JOBS_RETRY_DELAY_SECONDS=1.0
