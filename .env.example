# Copy this file to .env and give each value. The environment overrides the file.

# memory keeps all data in the process. sqlite keeps the tasks, the users, the
# revoked tokens, the jobs and the schedule lock in the SQLite file. A relative
# path starts at the folder in which the process starts.
DATABASE_BACKEND=memory
DATABASE_SQLITE_PATH=var/bustan-sample.db

# Make the secret with: uv run python -c 'import secrets; print(secrets.token_urlsafe(48))'
IDENTITY_JWT_SECRET=replace-with-a-random-value-of-at-least-32-characters
IDENTITY_JWT_ISSUER=bustan-sample
IDENTITY_TOKEN_TTL_MINUTES=15

# The number of job workers, and the delay before the first retry of a failed
# job. Each next retry waits two times longer.
JOBS_WORKERS=2
JOBS_RETRY_DELAY_SECONDS=1.0
# sqlite only: the time between two looks for new jobs, and the time after
# which a different worker can take a job that a stopped process did not end.
JOBS_POLL_SECONDS=0.5
JOBS_LEASE_SECONDS=300
# false: this process runs no schedules. Use it to have one scheduler process.
JOBS_SCHEDULER_ENABLED=true
